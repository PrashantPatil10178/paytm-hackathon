{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalDependencies": [
    ".env"
  ],
  "globalPassThroughEnv": [
    "API_URL",
    "DATABASE_URL",
    "AGENT_URL",
    "AGENT_MODEL",
    "AGENT_PORT",
    "PORT",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_BASE_URL",
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL",
    "COPILOT_PORT",
    "COPILOT_URL",
    "COPILOT_MODEL",
    "SHOPKART_CHANNEL_TOKEN",
    "RESOLVEAI_INTERNAL_KEY",
    "VITE_AGENT_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {}
  }
}
