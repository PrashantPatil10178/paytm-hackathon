# Postgres for the demo data (apps/api) and the agents' memory (apps/agent). Required.
# The API creates the tables and seeds them on first start.
DATABASE_URL=postgres://user:password@host:5432/postgres

# Where the screens find the demo API (each app proxies /api/* here)
API_URL=http://localhost:4000

# Set to forward POST /chat, /lead, /analysis and /campaigns/sync to the real ResolveAI agent.
# Leave empty to use the built-in stand-in.
AGENT_URL=

# ResolveAI channel token the demo API uses when it forwards ShopKart chats to the agent's POST /intake.
# Empty: a fresh one is issued each time the API starts. Create or rotate it on Control Room → Channels.
SHOPKART_CHANNEL_TOKEN=

# Optional shared secret between the demo API and the agent for the agent-only routes
# (/resolveai/channels/authenticate, /resolveai/connectors/access, the agent's /approvals/:id/decided).
RESOLVEAI_INTERNAL_KEY=

# Models for the agents in apps/agent ("provider/model"), two tiers:
# heavy (support, analysis). Empty: anthropic/claude-sonnet-5 with ANTHROPIC_API_KEY (or CLAUDE_API_KEY).
AGENT_MODEL_HEAVY=
# lite (sales, leads). Empty: AGENT_MODEL, then COPILOT_MODEL, then openai/gpt-5.6-luna (Azure OpenAI keys below).
AGENT_MODEL_LITE=

# Agent memory threads idle longer than this many days are deleted (checked on start and every 6 h). 0 keeps them.
AGENT_MEMORY_RETENTION_DAYS=30

# Ask Aria (Control Room chat, apps/copilot). Real keys go in .env only, never here.
# COPILOT_MODEL is "provider/model". Default: anthropic/claude-opus-5-5 with ANTHROPIC_API_KEY.
COPILOT_MODEL=
ANTHROPIC_API_KEY=
# Azure OpenAI instead: COPILOT_MODEL=openai/<deployment>, e.g. openai/gpt-5.6-luna
OPENAI_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1
OPENAI_API_KEY=
